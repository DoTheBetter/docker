# caddy reload --config /config/Caddyfile
# https://caddyserver.com/docs/caddyfile
#####################全局选项#############################
{
  # 日志配置（console 格式，本地时间）
  log {
    format console {
      time_format wall
      time_local
    }
  }
  ## 用于创建https证书ACME帐户
  #email email@example.com
  ## caddy-webdav
  #order webdav before file_server
  ## 用于创建https证书dns帐户
  #acme_dns alidns {
  #  access_key_id {env.ALIYUN_ACCESS_KEY_ID}
  #  access_key_secret {env.ALIYUN_ACCESS_KEY_SECRET}
  #}
  ## caddy-geo-ops插件geoip管理（数据库目录/data/GeoIP，首次启动由内置GeoIP Update服务自动初始下载数据库）
  ## 按需启用（geo_ops块/db_path为基础，两种用法都必须启用）：
  ## 1.仅用geo_ops匹配器过滤（如@cn geo_ops ...）→ 无需order geo_ops first；
  ## 2.站点内使用geo_ops指令输出{geo.*}占位符 → 需同时启用order geo_ops first；
  ## 3.需插件通过MaxMind官方协议自动更新（需同时配置GEOIPUPDATE_ACCOUNT_ID/GEOIPUPDATE_LICENSE_KEY环境变量）→ 追加启用auto_update相关四行（此后GeoIP Update服务完成初始下载即自动退出，两种更新方式二选一）
  #order geo_ops first
  #geo_ops {
  #  db_path /data/GeoIP
  #  auto_update #定时自动更新数据库（仅配置MaxMind凭证时生效）
  #  update_frequency {env.GEOIPUPDATE_FREQUENCY}h #更新检查间隔（仅auto_update启用时生效）
  #  account_id {env.GEOIPUPDATE_ACCOUNT_ID} #MaxMind账号ID
  #  license_key {env.GEOIPUPDATE_LICENSE_KEY} #MaxMind许可密钥
  #}
  ## CDN/前置代理场景需信任代理头，否则geoip与{client_ip}取到的是CDN节点IP
  servers {
    trusted_proxies static private_ranges
    client_ip_headers X-Forwarded-For
  }
}

####################自定义块##########################
#geoip数据库由caddy-geo-ops插件统一管理（文件变更热重载 + auto_update定时更新），存放于/data/GeoIP目录
#示例以P3TERX镜像源的geolite2-country.mmdb为例
#可通过环境变量GEOIPUPDATE_EDITION_IDS扩展下载数据库（如GeoLite2-City、GeoLite2-ASN），对应占位符库名为geolite2-city/geolite2-asn
#国家代码https://dev.maxmind.com/geoip/legacy/codes
