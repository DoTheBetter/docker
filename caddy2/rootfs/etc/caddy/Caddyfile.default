# 手动重载配置：caddy reload --config /config/Caddyfile
# Caddyfile 语法文档：https://caddyserver.com/docs/caddyfile
######################全局选项######################
{
  # 日志配置（console 格式，本地时间）
  log {
    format console {
      time_format wall
      time_local
    }
  }
  # 创建 HTTPS 证书的 ACME 账户邮箱（自动 HTTPS 需要时填写）
  #email email@example.com
  # caddy-webdav 插件：调整指令执行顺序
  #order webdav before file_server
  # 阿里云 DNS 挑战账号（签发泛域名/内网证书用）
  #acme_dns alidns {
  #  access_key_id {env.ALIYUN_ACCESS_KEY_ID}
  #  access_key_secret {env.ALIYUN_ACCESS_KEY_SECRET}
  #}
  # caddy-geo-ops 插件：GeoIP 数据库管理（目录 /data/GeoIP；首次启动由 init 脚本在 Caddy 启动前下载初始化）
  # 自动更新：已配置 GEOIPUPDATE_ACCOUNT_ID / GEOIPUPDATE_LICENSE_KEY 时，init 会在 /config/geoopts.caddy 中追加 auto_update 配置（走 MaxMind 官方协议）；未配置则仅加载库供 {geo.*} 匹配
  #order geo_ops first          # 仅需使用 {geo.*} 占位符时才启用
  #import /config/geoopts.caddy # geo_ops 块配置（由 init 脚本根据环境变量自动生成）
  # 经 CDN/反向代理访问时需信任代理头，否则 geoip 与 {client_ip} 取到的是 CDN 节点 IP
  servers {
    trusted_proxies static private_ranges
    client_ip_headers X-Forwarded-For
  }
}

####################GeoIP 过滤说明####################
# geoip 数据库由 caddy-geo-ops 插件统一管理（文件变更自动热重载 + auto_update 定时更新），存放于 /data/GeoIP
# 可通过环境变量 GEOIPUPDATE_EDITION_IDS 扩展下载多个数据库（如 GeoLite2-City、GeoLite2-ASN），对应 {geo.*} 占位符库名为 geolite2-city / geolite2-asn
# 国家码对照：https://dev.maxmind.com/geoip/legacy/codes
# geo 过滤逻辑已由 init 脚本根据环境变量自动生成于 /config/geofilter.caddy：
#   - 放行 GEOFILTER_COUNTRIES 指定国家码 + GEOFILTER_WHITELIST 白名单 IP/CIDR
#   - 其余请求返回 403 提示页
# 站点 handle 内使用 import /config/geofilter.caddy 引入即可，无需手动书写过滤逻辑
# 单独文件的目的：规避 caddy-docker-proxy 重序列化对 heredoc 空行 / 空 handle 块的破坏

######################站点######################
# 未 import geo 过滤片段的站点，如需 {geo.*} 占位符，请单独添加 geo_ops 指令（需配合全局选项中的 order geo_ops first）
#webdav.example.com {
#  import /config/geofilter.caddy      # 引用 geo 过滤逻辑（放行国内+白名单，已内含 geo_ops 指令）
#  header +X-Geo-Country {geo.geolite2-country.country.iso_code}  # 向客户端响应头输出访客国家
#  encode zstd gzip                     # 可选：启用压缩
#  basic_auth {                         # 可选：基础认证
#    example-user HASHED_PASSWORD
#  }
#  webdav {
#    root /opt/sites/Webdav-Site
#  }
#  tls {
#    dns alidns {
#      access_key_id {env.ALIYUN_ACCESS_KEY_ID}
#      access_key_secret {env.ALIYUN_ACCESS_KEY_SECRET}
#    }
#  }
#}

# 默认站点：未 import geo 过滤片段，不对访问做地理过滤
:80 {
    # 网站根目录
    root * /usr/share/caddy
    # 运行静态文件服务
    file_server
    # 反向代理（可选）
    # reverse_proxy localhost:8080
    # php-fpm（可选）
    # php_fastcgi localhost:9000
}