#!/command/with-contenv sh

# GeoIP 数据定时更新服务（GEOIPUPDATE_AUTO=true 时启用）
# 初始下载由 init 阶段 08-init.sh 完成（caddy启动前库即就绪）；本服务仅处理未配置凭证的场景：
# 启动时库不全则立即补全，随后按 GEOIPUPDATE_FREQUENCY 定时从镜像源更新
# 已配置 MaxMind 凭证：启动即退出（初始下载已由init完成），定时更新由 caddy-geo-ops 插件 auto_update 走官方协议

if [ "$GEOIPUPDATE_AUTO" != "true" ]; then
    echo "[GeoIP Update] 【未开启GeoIP Update（GEOIPUPDATE_AUTO!=true），本服务退出】"
    s6-svc -O .
    exit 0
fi

# 已配置MaxMind凭证——本服务无需运行，直接退出（初始下载已由init阶段完成，定时更新由auto_update接管）
if [ -n "$GEOIPUPDATE_ACCOUNT_ID" ] && [ -n "$GEOIPUPDATE_LICENSE_KEY" ]; then
    echo "[GeoIP Update] $(date "+%Y-%m-%d %H:%M:%S")：【已配置MaxMind凭证，定时更新由caddy-geo-ops插件auto_update接管（需在Caddyfile中启用auto_update及account_id/license_key配置），本服务退出】"
    s6-svc -O .
    exit 0
fi

GEOIP_DB_DIR=${XDG_DATA_HOME}/GeoIP
frequency=$((GEOIPUPDATE_FREQUENCY * 60 * 60))

echo "+正在启动 GeoIP Update 服务..."

# 下载函数：$1为数据库名（如GeoLite2-Country），下载到临时文件，大小校验（正常mmdb库远大于1MB）通过后原子替换，失败保留原文件
# 数据库名转小写即为caddy-geo-ops插件的规范文件名（匹配不区分大小写，如GeoLite2-Country → geolite2-country.mmdb）
download_db() {
    edition=$1
    db_name=$(echo "$edition" | tr 'A-Z' 'a-z')
    db_file=$GEOIP_DB_DIR/${db_name}.mmdb
    tmp_file=$GEOIP_DB_DIR/.${db_name}.mmdb.tmp
    # timeout 300 限制单次下载整体耗时（连接建立后的传输挂起也受控），避免卡死周期循环；与 init 阶段 timeout 120 一致的防护思路
    if timeout 300 curl -fSL --retry 3 --connect-timeout 30 -o "$tmp_file" "$GEOIPUPDATE_DL_URL/${edition}.mmdb" && [ "$(wc -c < "$tmp_file")" -gt 1000000 ]; then
        mv -f "$tmp_file" "$db_file"
        echo "[GeoIP Update] $(date "+%Y-%m-%d %H:%M:%S")：【${db_name}.mmdb 下载更新成功】"
    else
        echo "[GeoIP Update] $(date "+%Y-%m-%d %H:%M:%S")：【${db_name}.mmdb 下载失败或校验未通过，保留原文件】"
        rm -f "$tmp_file"
    fi
}

# 检查GEOIPUPDATE_EDITION_IDS中配置的所有库是否都已存在（多库场景必须逐一核对，任一缺失都算不完整）
all_dbs_present() {
    for edition in $(echo $GEOIPUPDATE_EDITION_IDS | tr ',' ' '); do
        db_name=$(echo "$edition" | tr 'A-Z' 'a-z')
        if [ ! -f "$GEOIP_DB_DIR/${db_name}.mmdb" ]; then
            return 1
        fi
    done
    return 0
}

# 检查数据库完整性，不全则立即补全（仅下载缺失库，已有库不重下；初始下载由init阶段完成）
if ! all_dbs_present; then
    echo "[GeoIP Update] $(date "+%Y-%m-%d %H:%M:%S")：【检测到geoip数据库不全，正在下载缺失库...】"
    for edition in $(echo $GEOIPUPDATE_EDITION_IDS | tr ',' ' '); do
        db_name=$(echo "$edition" | tr 'A-Z' 'a-z')
        [ -f "$GEOIP_DB_DIR/${db_name}.mmdb" ] || download_db $edition
    done
    # 补全结果不阻塞流程：仍有缺失（如镜像源故障）时由下方周期循环继续重试（download_db幂等，更新即补全）
    all_dbs_present && echo "[GeoIP Update] $(date "+%Y-%m-%d %H:%M:%S")：【数据库补全完成】" \
        || echo "[GeoIP Update] $(date "+%Y-%m-%d %H:%M:%S")：【补全未完成，等待下次更新周期重试】"
fi

# 进入周期更新循环（先等周期再更新，避免重复下载init刚获取的库）
while true; do
    echo "[GeoIP Update] $(date "+%Y-%m-%d %H:%M:%S")：【$GEOIPUPDATE_FREQUENCY小时后进行下一次geoip数据检查】"
    sleep "$frequency" &
    wait $!
    echo "[GeoIP Update] $(date "+%Y-%m-%d %H:%M:%S")：【正在更新geoip数据...】"
    for edition in $(echo $GEOIPUPDATE_EDITION_IDS | tr ',' ' '); do
        download_db $edition
    done
done
